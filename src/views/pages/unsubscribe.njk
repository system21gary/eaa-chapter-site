{% extends "layouts/base.njk" %}

{% block content %}
<section class="band">
  <div class="wrap-narrow">
    <div style="text-align:center; margin-bottom:2rem">
      <span class="eyebrow" style="justify-content:center">EAA Chapter 1699</span>
      <h1>Email preferences</h1>
    </div>

    <div class="form-card">
      {% if state == 'confirm' %}
        <p>Stop getting <strong>{{ label | lower }}</strong> from the chapter?</p>
        <p class="small muted">Account and security emails, and anything the board needs from you, are not affected.</p>
        <form method="post" action="{{ ('/unsubscribe/' ~ token) | url }}">
          <button type="submit" class="btn btn-primary btn-block">Unsubscribe</button>
        </form>
      {% elif state == 'done' %}
        <p><strong>Done.</strong> You will no longer get {{ label | lower }}.</p>
        <p class="small muted">Changed your mind?</p>
        <form method="post" action="{{ ('/unsubscribe/' ~ token ~ '/resubscribe') | url }}">
          <button type="submit" class="btn btn-outline btn-block">Turn {{ label | lower }} back on</button>
        </form>
      {% elif state == 'back' %}
        <p><strong>Welcome back.</strong> {{ label }} are switched on again.</p>
      {% else %}
        <p><strong>This link is not valid.</strong></p>
        <p class="small muted">It may have been copied incompletely. Sign in and use your account page to choose what email you get.</p>
        <a class="btn btn-outline btn-block" href="{{ '/members/account' | url }}">Your account</a>
      {% endif %}
    </div>
  </div>
</section>
{% endblock %}
