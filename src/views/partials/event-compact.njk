{# One line per event, grouped by month. Sits beside the card grid; the toggle chooses which is shown. #}
<div class="event-compact" data-panel="compact" hidden>
  {% for group in events | bymonth %}
    <section class="compact-month" aria-labelledby="month-{{ loop.index }}-{{ idSuffix }}">
      <h2 id="month-{{ loop.index }}-{{ idSuffix }}">{{ group.label }}</h2>
      <ul>
        {% for event in group.events %}
          <li>
            <a class="compact-row" href="{{ '' | url }}/events/{{ event.slug }}">
              <span class="when">{{ event.starts_at | dayline }}</span>
              <span class="title">{{ event.title }}</span>
              <span class="meta">
                {% if event.status == 'cancelled' %}<span class="pill pill-red">Cancelled</span>{% endif %}
                {% if event.status == 'draft' %}<span class="pill pill-grey">Draft</span>{% endif %}
                {% if event.photo_count %}<span class="pill pill-amber">{{ event.photo_count }} photos</span>{% endif %}
                <span class="pill">{{ event.kind | replace("-", " ") }}</span>
                <span class="time">{{ event.starts_at | timerange(event.ends_at, event.all_day) }}</span>
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endfor %}
</div>
