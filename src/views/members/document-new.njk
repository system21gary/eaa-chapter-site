{% extends "layouts/base.njk" %}

{% macro err(errors, name) %}
  {% if errors[name] %}<span class="err">{{ errors[name] }}</span>{% endif %}
{% endmacro %}

{% block content %}
<section class="band">
  <div class="wrap-narrow">
    <p class="crumbs"><a href="{{ '/members/documents/board' | url }}">Board documents</a> <span aria-hidden="true">›</span> Add</p>
    <h1>Add a document</h1>

    <form method="post" action="{{ '/members/documents/board' | url }}" enctype="multipart/form-data" class="form-card" style="margin-top:1.5rem">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">

      <fieldset>
        <legend>Document</legend>

        <div class="field">
          <label for="kind">Type</label>
          <select id="kind" name="kind">
            {% for key, label in kinds %}
              <option value="{{ key }}" {{ 'selected' if form.kind == key }}>{{ label }}</option>
            {% endfor %}
          </select>
          {{ err(errors, 'kind') }}
        </div>

        <div class="field">
          <label for="title">Title</label>
          <input type="text" id="title" name="title" required maxlength="140" value="{{ form.title or '' }}"
                 placeholder="Board meeting minutes, November 2026" aria-invalid="{{ 'true' if errors.title }}">
          {{ err(errors, 'title') }}
        </div>

        <div class="field">
          <label for="event_id">Which meeting? <span class="muted">(for meeting minutes)</span></label>
          <select id="event_id" name="event_id">
            <option value="">Not for a particular meeting</option>
            {% for m in meetings %}
              <option value="{{ m.id }}" {{ 'selected' if form.event_id and form.event_id == m.id }}>{{ m.title }}, {{ m.starts_at | shortdate }}</option>
            {% endfor %}
          </select>
          {{ err(errors, 'event_id') }}
          <span class="hint">Choosing the meeting tells the site the minutes are in, so the Secretary is no longer reminded.</span>
        </div>

        <div class="field">
          <label for="meeting_date">Meeting date <span class="muted">(optional)</span></label>
          <input type="date" id="meeting_date" name="meeting_date" value="{{ form.meeting_date or '' }}">
          {{ err(errors, 'meeting_date') }}
          <span class="hint">Used to file it under the right year in the archive.</span>
        </div>

        <div class="field">
          <label for="file">File</label>
          <input type="file" id="file" name="file" required data-dropzone data-max-bytes="{{ maxMb * 1048576 }}" aria-invalid="{{ 'true' if errors.file }}">
          {{ err(errors, 'file') }}
          <span class="hint">{{ allowed }}. Up to {{ maxMb }} MB. Files with macros are not accepted.</span>
        </div>

        <div class="field">
          <label for="note">Note for the reviewers <span class="muted">(optional)</span></label>
          <textarea id="note" name="note" rows="3" maxlength="500">{{ form.note or '' }}</textarea>
          {{ err(errors, 'note') }}
        </div>
      </fieldset>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save as draft</button>
        <a class="btn btn-outline" href="{{ '/members/documents/board' | url }}">Cancel</a>
      </div>
    </form>
  </div>
</section>
{% endblock %}
