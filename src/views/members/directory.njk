{% extends "layouts/base.njk" %}

{% block content %}
<section class="band">
  <div class="wrap">
    <span class="eyebrow">Members Corner</span>
    <h1>Member directory</h1>
    <p class="muted" style="max-width:62ch">
      Contact details here are shared between chapter members only. They are
      never shown to the public and never sent to anyone outside this page —
      please treat them the same way.
    </p>

    {% if members.length %}
      {#- Both controls need JavaScript, so they stay hidden until site.js shows them. Without it the page is the
          plain card grid it always was. The filter runs in the browser over what is already on the page: a
          server-side search would also match hidden email addresses and so reveal them. -#}
      <div class="directory-tools" style="margin-top:2rem">
        <div class="directory-filter" data-filter hidden>
          <label for="directory-filter" class="sr-only">Filter members</label>
          <input type="search" id="directory-filter" placeholder="Filter by name, aircraft or airport" autocomplete="off" data-filter-input>
          <span class="small muted" data-filter-count aria-live="polite"></span>
        </div>
        <div class="view-toggle" data-view-toggle data-view-key="eaa1699.directory.view" hidden role="group" aria-label="Layout">
          <span class="small muted">View</span>
          <button type="button" class="btn btn-outline btn-sm" data-view="cards" aria-pressed="true">Cards</button>
          <button type="button" class="btn btn-outline btn-sm" data-view="compact" aria-pressed="false">Compact</button>
        </div>
      </div>
    {% endif %}

    <div class="grid grid-3 directory-grid" data-view-target data-filter-list>
      {% for member in members %}
        {#- What the filter matches: never an address or phone, shared or not. -#}
        <article class="card member-card" data-filter-item
                 data-filter-text="{{ [displayName(member), member.first_name, member.last_name, boardRoles[member.board_role] if member.board_role, member.aircraft, member.home_base] | join(' ') | lower }}">
          <div class="card-body">
            <div class="member-head">
              {% if member.avatar_path %}
                <img src="{{ member.avatar_path | media }}" alt="Photo of {{ displayName(member) }}" class="avatar avatar-lg avatar-zoomable" tabindex="0">
              {% else %}
                <span class="avatar avatar-lg avatar-initials" aria-hidden="true">{{ member | initials }}</span>
              {% endif %}
              <div class="member-name">
                <h3>{{ displayName(member) }}</h3>
                {% if member.board_role %}
                  <span class="pill pill-green">{{ boardRoles[member.board_role] }}</span>
                {% endif %}
                {% if member.role != 'member' %}
                  <span class="pill pill-amber">{{ member.role }}</span>
                {% endif %}
              </div>
            </div>

            {#- These two are always rendered, empty or not, so the compact rows keep their columns lined up.
                Keep each on one line: an empty one must be truly empty for :empty to hide it on a card. -#}
            <p class="small member-aircraft">{% if member.aircraft %}<strong class="member-label">Flies: </strong>{{ member.aircraft }}{% endif %}</p>
            <p class="small muted member-base">{% if member.home_base %}{{ member.home_base }}{% endif %}</p>
            {% if member.eaa_number %}
              <p class="tiny muted member-eaa">EAA #{{ member.eaa_number }}</p>
            {% endif %}

            {% if member.bio %}
              <p class="small muted member-bio">{{ member.bio | truncate(140) }}</p>
            {% endif %}

            <div class="small member-contact">
              {% if member.email %}<a href="mailto:{{ member.email }}">{{ member.email }}</a>{% endif %}
              {% if member.phone %}<a href="tel:{{ member.phone }}">{{ member.phone | phone }}</a>{% endif %}
              {% if member.can_message %}
                <a class="btn btn-outline btn-sm member-message" href="{{ '' | url }}/members/directory/{{ member.id }}/message">Send a message</a>
              {% elif not member.email and not member.phone %}
                <span class="muted member-private"><span class="member-private-long">Contact details are private. Ask an officer to pass on a message.</span><span class="member-private-short">Private</span></span>
              {% endif %}
            </div>
          </div>
        </article>
      {% else %}
        <div class="empty">
          <div class="icon">{{ icon("people", 44) }}</div>
          <h3>Nobody here yet</h3>
          <p>Once members activate their accounts they will show up here.</p>
        </div>
      {% endfor %}
    </div>
    <p class="empty small muted" data-filter-empty hidden>No members match that filter.</p>
  </div>
</section>
{% endblock %}
