{% extends "layouts/base.njk" %}

{% block content %}
<section class="band">
  <div class="wrap">
    <span class="eyebrow">Administrators</span>
    <h1>Activity log</h1>
    <p class="muted" style="max-width:65ch">
      Security-relevant actions, newest first. Client IP addresses are stored
      only as a keyed digest — enough to spot the same source hammering the
      login form, not enough to be a pile of personal data.
    </p>

    <div class="split log-split" style="margin-top:2rem">
      <div>
      <h2>Recent activity</h2>
      <div class="table-wrap scroll-box log-pane" style="margin-top:1rem" tabindex="0" role="region" aria-label="Recent activity, scrollable">
        <table class="data">
          <thead><tr><th>When</th><th>Who</th><th>Action</th><th>Detail</th></tr></thead>
          <tbody>
            {% for e in entries %}
              <tr>
                <td class="tiny muted" style="white-space:nowrap">{{ e.created_at | datetime }}</td>
                <td class="tiny">
                  {% if e.first_name %}{{ e.first_name }} {{ e.last_name }}{% else %}<span class="muted">anonymous</span>{% endif %}
                </td>
                <td>
                  <span class="pill {{ 'pill-red' if 'failed' in e.action or 'locked' in e.action }}{{ 'pill-green' if 'success' in e.action }}">
                    {{ e.action }}
                  </span>
                </td>
                <td class="tiny muted">
                  {{ e.detail or '' }}
                  {%- if e.entity %} <span class="mono">{{ e.entity }}#{{ e.entity_id }}</span>{% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      </div>

      <aside class="sidebar">
        <h2>Mail queue</h2>
        <div class="card log-pane" style="margin-top:1rem">
          <div class="card-body">
            {% if mailLive %}
              <p class="small muted">
                Sending over SMTP. Messages are queued here first and delivered
                by a background worker, so a relay problem never breaks the page
                somebody was on — it just retries.
              </p>
            {% else %}
              <p class="small muted">
                <strong>Nothing is being delivered.</strong> With no SMTP
                transport configured, invitation and reset links land here —
                which is how you bootstrap the first accounts, but it means no
                member can receive one.
              </p>
            {% endif %}

            {% if mailHealth.abandoned %}
              <div class="notice" style="margin:1rem 0">
                <strong>{{ mailHealth.abandoned }} message{{ 's' if mailHealth.abandoned != 1 }} could not be delivered</strong>
                after every retry. Fix the cause and use Retry, or — if the
                address was never meant to work, such as a sample member —
                Dismiss it. Dismissed failures stop appearing here and in the
                nightly backup email; only new ones are reported.
                <form method="post" action="{{ '' | url }}/members/admin/log/mail/dismiss-failed" style="margin-top:.6rem">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <button type="submit" class="btn btn-outline btn-sm">Dismiss all {{ mailHealth.abandoned }}</button>
                </form>
              </div>
            {% endif %}

            <ul class="plain small scroll-box scroll-box-fill" style="margin-top:1rem" tabindex="0" aria-label="Queued mail, scrollable">
              {% for m in outbox %}
                <li style="padding-bottom:.6rem; border-bottom:1px solid var(--line); margin-bottom:.6rem">
                  <a href="{{ '' | url }}/members/admin/log/mail/{{ m.id }}">{{ m.subject }}</a><br>
                  <span class="tiny muted mono">{{ m.to_addr }}</span><br>
                  <span class="tiny muted">
                    {{ m.created_at | relative }} ·
                    {% if m.state == 'sent' %}
                      sent
                    {% elif m.state == 'skipped' %}
                      not sent (sample address)
                    {% elif m.state == 'retrying' %}
                      <span style="color:var(--red)">attempt {{ m.attempts }} failed, retrying</span>
                    {% elif m.state == 'dismissed' %}
                      gave up after {{ m.attempts }} attempts · dismissed
                    {% elif m.state == 'failed' %}
                      <span style="color:var(--red)">gave up after {{ m.attempts }} attempts</span>
                    {% elif m.state == 'queued' %}
                      queued
                    {% else %}
                      held (no transport when it was written)
                    {% endif %}
                  </span>

                  {% if m.error and m.state != 'skipped' %}
                    {# The reason, which is a server message and never contains a
                       credential — the mailer strips those before storing. #}
                    <br><span class="tiny mono muted">{{ m.error }}</span>
                  {% endif %}

                  {% if not m.sent_at and m.state != 'skipped' %}
                    <div style="margin-top:.4rem; display:flex; gap:.4rem; flex-wrap:wrap">
                      <form method="post" action="{{ '' | url }}/members/admin/log/mail/{{ m.id }}/retry">
                        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                        <button type="submit" class="btn btn-outline btn-sm">Retry now</button>
                      </form>
                      {% if m.state == 'failed' %}
                        <form method="post" action="{{ '' | url }}/members/admin/log/mail/{{ m.id }}/dismiss">
                          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                          <button type="submit" class="btn btn-outline btn-sm">Dismiss</button>
                        </form>
                      {% endif %}
                    </div>
                  {% endif %}
                </li>
              {% else %}
                <li class="muted">Nothing queued.</li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </aside>
    </div>

    <footer class="site-footnote">
      <h3>Site info</h3>
      <ul class="factlist small">
      <li><span class="label">Node</span><span class="mono">{{ sys.nodeVersion }}</span></li>
      <li><span class="label">Up for</span><span>{{ sys.uptime }}</span></li>
      <li><span class="label">Last restart</span><span>{{ sys.startedAt | datetime }} <span class="tiny muted">({{ sys.startedAt | relative }})</span></span></li>
      <li><span class="label">Environment</span><span>{{ sys.environment }}</span></li>
      {% if sys.appVersion %}<li><span class="label">App version</span><span class="mono">{{ sys.appVersion }}</span></li>{% endif %}
      <li><span class="label">Schema</span><span>{% if sys.schema !== null %}migration {{ sys.schema }}{% else %}unknown{% endif %}</span></li>
      <li><span class="label">Memory</span><span>{{ sys.memory }} <span class="tiny muted">(heap {{ sys.heap }}; machine {{ sys.machineMemory }})</span></span></li>
      {% if sys.database %}<li><span class="label">Database</span><span>{{ sys.database }}{% if sys.wal %} <span class="tiny muted">(+ {{ sys.wal }} write-ahead log)</span>{% endif %}</span></li>{% endif %}
      {% if sys.disk %}<li><span class="label">Disk</span><span>{{ sys.disk.usedPercent }}% full <span class="tiny muted">({{ sys.disk.free }} free of {{ sys.disk.total }})</span></span></li>{% endif %}
      <li><span class="label">Backups</span><span>{{ 'Replicating to a bucket' if sys.backupConfigured else 'Not configured' }}</span></li>
      <li><span class="label">Scheduler</span><span>{{ 'On' if sys.scheduler else 'Off' }}</span></li>
      <li><span class="label">Platform</span><span>{{ sys.platform }}</span></li>
      <li><span class="label">Time zone</span><span>{{ sys.timezone }}</span></li>
      {% if sys.fly %}
        <li><span class="label">Fly</span><span>{{ sys.fly.app }}{% if sys.fly.region %} · {{ sys.fly.region }}{% endif %}</span></li>
        {% if sys.fly.machine %}<li><span class="label">Machine</span><span class="mono">{{ sys.fly.machine }}</span></li>{% endif %}
      {% endif %}
      </ul>
    </footer>
  </div>
</section>
{% endblock %}
