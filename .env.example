# ---------------------------------------------------------------------------
# EAA Chapter 1699 — environment
# Copy to .env for local development. Never commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# --- Secrets ---------------------------------------------------------------
# REQUIRED in production; must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
CSRF_SECRET=

# Optional server-side pepper mixed into every password hash. Setting this
# means a stolen database alone is not enough to mount an offline attack.
# Changing it invalidates every existing password — everyone would need a reset.
PASSWORD_PEPPER=

# --- Deployment ------------------------------------------------------------
# Set to 1 only when running behind a reverse proxy you control (nginx, Caddy,
# Fly, Render). Trusting proxy headers otherwise lets clients spoof their IP
# and bypass rate limiting.
TRUST_PROXY=0

# Force secure cookies. Defaults to on in production.
SECURE_COOKIES=

# Path prefix, if the site is not at a domain root. Normally empty.
# Set it when a proxy exposes the app under a path — a Coder/code-server port
# proxy, Gitpod, or shared hosting where this is one app among several:
#   BASE_PATH=/tasks/<id>/vscode/proxy/3000
# Every generated URL is prefixed with it and incoming requests have it
# stripped, so the same build works at a root or under a prefix. Leaving it
# unset when the site IS behind a path prefix is what produces an unstyled
# page: the HTML arrives, /assets/css/site.css resolves to the domain root.
# Changing it invalidates links on any page a browser already has open.
BASE_PATH=

# Extra origins allowed to submit forms, comma separated. BASE_URL is always
# allowed; add others here (a bare domain alongside a www one, say). Behind a
# reverse proxy BASE_URL must be the public origin, or every POST is refused
# as cross-origin.
ALLOWED_ORIGINS=

# --- Storage ---------------------------------------------------------------
DATA_DIR=./data
DB_FILE=./data/eaa1699.sqlite
UPLOAD_DIR=./data/uploads

# --- Authentication --------------------------------------------------------
SESSION_MAX_AGE_HOURS=12
MIN_PASSWORD_LENGTH=12
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15
RESET_TOKEN_TTL_MINUTES=60
INVITE_TTL_DAYS=14

# Check new passwords against Have I Been Pwned using k-anonymity (only the
# first 5 characters of the SHA-1 leave this server). Off by default so the
# site works with no outbound network access.
PWNED_CHECK=0

# --- Uploads ---------------------------------------------------------------
UPLOAD_MAX_BYTES=12582912
UPLOAD_MAX_FILES=8

# --- Mail ------------------------------------------------------------------
# 'outbox' queues mail in the database and prints it to the console, which is
# how you read the first invitation links on a fresh install. Nothing is
# delivered. 'smtp' delivers for real and needs the SMTP_* settings below.
#
# Check it before trusting it:  npm run mail:check -- you@example.com
MAIL_TRANSPORT=outbox

# The address members see. Keep it on a domain you control, or providers will
# treat it as forged and file the whole lot as spam.
MAIL_FROM=EAA Chapter 1699 <no-reply@eaa1699.org>

# Where replies to that no-reply address should actually go. Optional.
MAIL_REPLY_TO=

# Where the contact form and new membership requests are sent.
CONTACT_EMAIL=info@eaa1699.org

# SMTP, for MAIL_TRANSPORT=smtp. NOT IMAP: IMAP reads a mailbox and cannot
# send. Your provider offers both, usually on the same username and password —
# it is the host and port that differ.
#
#   port 587 + SMTP_SECURE=0  STARTTLS. What almost everyone wants.
#   port 465 + SMTP_SECURE=1  implicit TLS.
#   port 25                   don't. Google Cloud blocks it outbound entirely.
#
# Most providers reject your normal account password over SMTP and require an
# app-specific password (Gmail/Workspace: needs 2-step verification on first).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Refuse to continue unencrypted if the server does not offer STARTTLS.
# Leave on: turning it off can hand your password over in the clear.
SMTP_REQUIRE_TLS=1

# Only for an internal relay with a self-signed certificate. Never for a
# public provider — it stops verifying that the server is who it claims.
SMTP_ALLOW_INVALID_CERTS=0

# How often the background worker looks for messages to deliver.
MAIL_POLL_SECONDS=60

# Domains never to attempt delivery to, comma separated. The defaults are the
# domains RFC 2606 reserves for documentation, which is what the demo members
# and the test suites use. Nothing can receive mail there, so attempting it only
# produces bounces — and bounces against a new sending domain are how a
# chapter's mail ends up in everyone's spam folder.
MAIL_SUPPRESS_DOMAINS=example.com,example.org,example.net,test,invalid,localhost

# Allow admins to read queued mail bodies in production. These contain live
# reset tokens — leave off unless you are bootstrapping.
ALLOW_OUTBOX_VIEW=0

# --- Development -----------------------------------------------------------
# Rate limits are relaxed in development; set to 1 to exercise them.
ENFORCE_LIMITS=0

# Seed a different admin address.
SEED_ADMIN_EMAIL=gary.jones@hawthorncs.com

# --- Backups -----------------------------------------------------------------
# On Fly, attaching a Tigris bucket (`fly storage create`) is all that is
# needed: scripts/start.sh builds the Litestream replica URL from BUCKET_NAME.
# Set this instead to back up somewhere else S3-compatible, or to
# file:///some/dir to try it out locally.
# LITESTREAM_REPLICA_URL=

# The morning backup report. On in production, off in development.
# BACKUP_REPORT=1
# Who gets it, comma separated. Empty: every active administrator.
# BACKUP_REPORT_TO=
# Hour (Eastern) at or after which it is sent.
# BACKUP_REPORT_HOUR=6
